#Write a Python program to check that a 
#string contains only a certain set of 
#characters (in this case a-z, A-Z and 0-9).
import re

sample = input("Write the String: ")
pattern = r"^[a-zA-Z0-9\s]+$"

if re.match(pattern, sample):
    print("Yes, the String contains only a certain set of Characters")
else:
    print("No, invalid characters found")



